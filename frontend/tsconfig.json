{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@shared-types": ["./src/shared-types/index"],
      "@apis": ["./src/apis/index"],
      "@store": ["./src/store/index"],
      "@store/*": ["./src/store/*"],
      "@hooks": ["./src/hooks/index"],
      "@hooks/*": ["./src/hooks/*"],
      "@components/*": ["./src/components/*"],
      "@constants": ["./src/constants/index"],
      "@utils": ["./src/utils/index"],
      "@utils/*": ["./src/utils/*"],
      "@lib": ["./src/lib/index"],
      "@layouts/*": ["./src/layouts/index"],
      "@styles/*": ["./src/styles/*"],
      "@*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
